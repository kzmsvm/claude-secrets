#!/usr/bin/env bash
# claude-secrets CLI dispatcher.
# Usage:
#   cs add                  open browser UI to add a new secret
#   cs ui-status             show URL/PID of running UI (or "not running")
#   cs ui-stop               kill running UI server
#   cs autostart-install     run UI at every macOS login (LaunchAgent)
#   cs autostart-remove      disable login autostart
#   cs list                  list stored secrets (names only)
#   cs get <name>            print secret value to stdout
#   cs set <name> <val>      set secret (or update)
#   cs note <name> "<text>"  attach / read a free-form description note
#   cs describe <name>       show length + note (without revealing value)
#   cs rm  <name>            delete secret
#   cs load                  export all secrets as env vars (run with `source`)
#   cs export <name>         print as `export KEY=value` for shell sourcing
#   cs import <file.env>     import a .env-style file into this namespace
#   cs ui                    same as `cs add` — opens browser
#   cs help                  show this help

set -u

# Namespace prefix in Keychain (default: "cs", overridable via env).
CS_NAMESPACE="${CS_NAMESPACE:-cs}"

usage() {
    sed -n '2,12p' "$0" | sed 's/^# //;s/^#//'
}

require_macos() {
    if [ "$(uname)" != "Darwin" ]; then
        echo "claude-secrets: only macOS is supported right now (uses Keychain via \`security\`)." >&2
        exit 2
    fi
}

cmd_set() {
    local name="${1:-}" value="${2:-}"
    if [ -z "$name" ] || [ -z "$value" ]; then
        echo "usage: cs set <name> <value>" >&2; return 2
    fi
    security add-generic-password -U -a "$USER" -s "$CS_NAMESPACE-$name" -w "$value" >/dev/null 2>&1
    echo "stored: $CS_NAMESPACE-$name"
}

# Attach / read metadata notes for an entry.
# Metadata is stored as a sibling entry "<name>__meta" so it's separate from
# the actual secret — listing it shows up but it's purely descriptive.
_kc_read_decoded() {
    # security CLI returns hex for values that aren't pure ASCII (e.g. notes
    # with em-dashes). Detect and decode.
    local raw="$1"
    if echo "$raw" | grep -qE '^[0-9a-f]+$' && [ $((${#raw} % 2)) -eq 0 ] && [ ${#raw} -gt 4 ]; then
        echo "$raw" | xxd -r -p
    else
        printf '%s\n' "$raw"
    fi
}

cmd_note() {
    local name="${1:-}" note="${2:-}"
    if [ -z "$name" ]; then
        echo "usage: cs note <name> [\"<text>\"]    (omit text to print existing note)" >&2; return 2
    fi
    local meta_key="${name}__meta"
    if [ -z "$note" ]; then
        # Read mode
        local existing
        existing=$(security find-generic-password -a "$USER" -s "$CS_NAMESPACE-$meta_key" -w 2>/dev/null)
        if [ -n "$existing" ]; then
            _kc_read_decoded "$existing"
        else
            echo "(no note set for $CS_NAMESPACE-$name)" >&2
            return 1
        fi
    else
        # Write mode
        security add-generic-password -U -a "$USER" -s "$CS_NAMESPACE-$meta_key" -w "$note" >/dev/null 2>&1
        echo "note saved for: $CS_NAMESPACE-$name"
    fi
}

# Describe an entry — value length + sibling metadata in one shot.
# Designed so an AI agent can call this BEFORE cs_inject to know what
# to do with the secret (ftp creds? bearer token? SSH private key?).
cmd_describe() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "usage: cs describe <name>" >&2; return 2
    fi
    local val len note
    val=$(security find-generic-password -a "$USER" -s "$CS_NAMESPACE-$name" -w 2>/dev/null)
    if [ -z "$val" ]; then
        echo "no entry: $CS_NAMESPACE-$name" >&2; return 1
    fi
    len=${#val}
    note=$(security find-generic-password -a "$USER" -s "$CS_NAMESPACE-${name}__meta" -w 2>/dev/null)
    echo "name:         $CS_NAMESPACE-$name"
    echo "value_length: $len chars"
    if [ -n "$note" ]; then
        echo "note: |"
        _kc_read_decoded "$note" | sed 's/^/  /'
    else
        echo "note:         (none — set with: cs note $name \"...\")"
    fi
}

cmd_get() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "usage: cs get <name>" >&2; return 2
    fi
    security find-generic-password -a "$USER" -s "$CS_NAMESPACE-$name" -w 2>/dev/null
}

cmd_rm() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "usage: cs rm <name>" >&2; return 2
    fi
    if security delete-generic-password -s "$CS_NAMESPACE-$name" >/dev/null 2>&1; then
        echo "removed: $CS_NAMESPACE-$name"
    else
        echo "not found: $CS_NAMESPACE-$name" >&2
        return 1
    fi
}

cmd_list() {
    # Dump login keychain and grep for our namespace prefix.
    # Filter out '__meta' companion entries — those are notes for cs_describe,
    # not secrets, and shouldn't pollute the list output.
    security dump-keychain 2>/dev/null \
      | grep -E '"svce".*"'"$CS_NAMESPACE"'-' \
      | sed -E 's/.*"('"$CS_NAMESPACE"'-[^"]+)".*/\1/' \
      | grep -v '__meta$' \
      | sort -u
}

cmd_export() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "usage: cs export <name>" >&2; return 2
    fi
    local val; val=$(cmd_get "$name")
    if [ -z "$val" ]; then
        echo "not found: $CS_NAMESPACE-$name" >&2; return 1
    fi
    # Convert kebab-case → SNAKE_CASE for env var name.
    local var
    var=$(echo "$name" | tr 'a-z-' 'A-Z_')
    echo "export $var='$val'"
}

cmd_load() {
    # Emit `export FOO=...` for every stored secret. Caller is expected to `eval` or `source`.
    local item var val
    while IFS= read -r item; do
        [ -z "$item" ] && continue
        local short="${item#$CS_NAMESPACE-}"
        var=$(echo "$short" | tr 'a-z-' 'A-Z_')
        val=$(security find-generic-password -a "$USER" -s "$item" -w 2>/dev/null)
        if [ -n "$val" ]; then
            # Escape single quotes inside the value.
            local esc; esc=${val//\'/\'\\\'\'}
            echo "export $var='$esc'"
        fi
    done < <(cmd_list)
}

cmd_ui() {
    local script_dir; script_dir="$(cd "$(dirname "$0")/.." && pwd)"
    exec python3 "$script_dir/ui/add-secret.py"
}

# Print the URL of the running UI (helps when you forget which port it's on).
cmd_ui_status() {
    local lock="${TMPDIR:-/tmp}/claude-secrets-ui-${USER}-${CS_NAMESPACE}.lock"
    if [ -f "$lock" ]; then
        local port pid
        port=$(python3 -c "import json; print(json.load(open('$lock'))['port'])" 2>/dev/null)
        pid=$(python3 -c "import json; print(json.load(open('$lock'))['pid'])" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "UI running: http://127.0.0.1:${port}  (PID ${pid})"
            return 0
        fi
        # stale lockfile
        rm -f "$lock"
    fi
    echo "no UI running for namespace \"$CS_NAMESPACE\". Start with: cs add"
    return 1
}

cmd_ui_stop() {
    local lock="${TMPDIR:-/tmp}/claude-secrets-ui-${USER}-${CS_NAMESPACE}.lock"
    if [ ! -f "$lock" ]; then
        echo "no UI running for namespace \"$CS_NAMESPACE\""; return 1
    fi
    local pid
    pid=$(python3 -c "import json; print(json.load(open('$lock'))['pid'])" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid"
        echo "stopped UI (PID $pid)"
    else
        echo "lockfile pointed at dead PID, cleaning up"
    fi
    rm -f "$lock"
}

# Install a macOS LaunchAgent so the UI server starts at login + restarts on crash.
cmd_autostart_install() {
    local agent_dir="$HOME/Library/LaunchAgents"
    local plist="$agent_dir/com.claude-secrets.ui.plist"
    local script_dir; script_dir="$(cd "$(dirname "$0")/.." && pwd)"
    local python_bin; python_bin="$(command -v python3)"
    [ -z "$python_bin" ] && { echo "python3 not found in PATH" >&2; return 2; }

    mkdir -p "$agent_dir"
    cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-secrets.ui</string>
    <key>ProgramArguments</key>
    <array>
        <string>${python_bin}</string>
        <string>${script_dir}/ui/add-secret.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${TMPDIR:-/tmp}/claude-secrets-ui.log</string>
    <key>StandardErrorPath</key>
    <string>${TMPDIR:-/tmp}/claude-secrets-ui.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CS_NAMESPACE</key>
        <string>${CS_NAMESPACE}</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
PLIST
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
    sleep 0.5
    echo "✔ autostart enabled — UI will run on every login and restart on crash"
    echo "  plist: $plist"
    echo "  logs:  ${TMPDIR:-/tmp}/claude-secrets-ui.log  (errors: …ui.err)"
    cmd_ui_status
}

cmd_autostart_remove() {
    local plist="$HOME/Library/LaunchAgents/com.claude-secrets.ui.plist"
    if [ ! -f "$plist" ]; then
        echo "no autostart installed"; return 1
    fi
    launchctl unload "$plist" 2>/dev/null || true
    rm -f "$plist"
    echo "✔ autostart removed"
    # Stop any currently running UI too
    cmd_ui_stop 2>/dev/null || true
}

# Import KEY=value lines from a .env-style file into the current namespace.
# Existing entries are overwritten (security CLI's -U flag). Quotes stripped.
# Lines starting with # or empty are ignored.
cmd_import() {
    local file="${1:-}" dry="${CS_DRY_RUN:-}"
    if [ -z "$file" ]; then
        echo "usage: cs import <path-to-.env> [--dry-run]" >&2; return 2
    fi
    if [ "${2:-}" = "--dry-run" ]; then dry=1; fi
    if [ ! -f "$file" ]; then
        echo "no such file: $file" >&2; return 1
    fi
    local count=0
    while IFS= read -r line || [ -n "$line" ]; do
        # Skip comments and blanks.
        case "$line" in ''|\#*) continue ;; esac
        # Allow optional "export " prefix; strip it.
        line="${line#export }"
        # Split on first =
        local key="${line%%=*}"
        local val="${line#*=}"
        [ "$key" = "$line" ] && continue   # no '=' found
        # Strip surrounding whitespace from key.
        key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
        [ -z "$key" ] && continue
        # Strip wrapping single or double quotes from value.
        case "$val" in
            \"*\") val="${val#\"}"; val="${val%\"}" ;;
            \'*\') val="${val#\'}"; val="${val%\'}" ;;
        esac
        # Convert KEY_LIKE_THIS → key-like-this for Keychain entry name.
        local name; name=$(echo "$key" | tr 'A-Z_' 'a-z-')
        # Skip empty values — .env often has placeholders we shouldn't store.
        if [ -z "$val" ]; then
            echo "skipped (empty): $CS_NAMESPACE-$name"
            continue
        fi
        if [ -n "$dry" ]; then
            echo "[dry-run] would store $CS_NAMESPACE-$name (${#val} chars)"
        else
            cmd_set "$name" "$val" >/dev/null
            echo "stored: $CS_NAMESPACE-$name"
        fi
        count=$((count+1))
    done < "$file"
    echo
    echo "$count entr$( [ "$count" = "1" ] && echo y || echo ies ) processed"
}

# ---------- dispatch ----------
require_macos
sub="${1:-help}"
shift || true
case "$sub" in
    set)      cmd_set      "$@" ;;
    get)      cmd_get      "$@" ;;
    rm)       cmd_rm       "$@" ;;
    list|ls)  cmd_list     "$@" ;;
    export)   cmd_export   "$@" ;;
    load)     cmd_load     "$@" ;;
    note)     cmd_note     "$@" ;;
    describe) cmd_describe "$@" ;;
    add|ui) cmd_ui     "$@" ;;
    ui-status)       cmd_ui_status        "$@" ;;
    ui-stop)         cmd_ui_stop          "$@" ;;
    autostart-install) cmd_autostart_install "$@" ;;
    autostart-remove)  cmd_autostart_remove  "$@" ;;
    import) cmd_import "$@" ;;
    help|-h|--help) usage ;;
    *)      echo "unknown command: $sub" >&2; usage; exit 2 ;;
esac
